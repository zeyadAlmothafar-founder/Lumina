# Get your free API key from https://aistudio.google.com/apikey
GOOGLE_AI_KEY=your_google_ai_studio_key_here

# Gemma 4 model for cloud API inference (Google AI Studio)
GEMMA_MODEL=gemma-4-31b-it

# Gemma 4 has native audio input — use the same model for voice transcription
TRANSCRIPTION_MODEL=gemma-4-31b-it

PORT=3001

# ── Local inference via Ollama (optional) ─────────────────────────────────────
# Install Ollama from https://ollama.com, then run: ollama pull gemma4
# The UI toggle lets users switch between cloud and local at any time.
# Leave these as-is if you only plan to use the cloud API.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_LOCAL=gemma4:e4b
